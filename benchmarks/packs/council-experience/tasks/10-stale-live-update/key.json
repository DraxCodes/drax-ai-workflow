{
  "criteria": [
    { "id": "C1", "weight": 4, "description": "the three-second read says the data is stale or disconnected", "path": "thesis.threeSecondRead", "match": "containsAny", "terms": ["stale", "disconnected", "last updated"] },
    { "id": "C2", "weight": 4, "description": "names retry, reconnect or wait as the first-run path", "path": "thesis.firstRunPath", "match": "containsAny", "terms": ["retry", "reconnect", "wait"] },
    { "id": "C3", "weight": 2, "description": "one sentence, no blame, names the last update", "path": "thesis.copyVoice", "match": "containsAny", "terms": ["sentence", "last updated", "no blame"] },
    { "id": "C4", "weight": 2, "description": "reconnect keeps the reader's place without a jump", "path": "thesis.goodMoment", "match": "containsAny", "terms": ["reconnect", "same place", "no jump"] },
    { "id": "C5", "weight": 2, "description": "avoids silent stale data, a spinner or a modal", "path": "thesis.frictionAvoided", "match": "containsAny", "terms": ["silent", "spinner", "modal"] },
    { "id": "C6", "weight": 2, "description": "gives at least two observable evidence points", "path": "evidence", "match": "minItems", "min": 2 },
    { "id": "C7", "weight": 2, "description": "names at least one non-goal", "path": "nonGoals", "match": "minItems", "min": 1 }
  ],
  "forbidden": [
    { "id": "F1", "weight": 4, "description": "uses a banned adjective", "terms": ["delightful", "seamless", "magical"] }
  ]
}