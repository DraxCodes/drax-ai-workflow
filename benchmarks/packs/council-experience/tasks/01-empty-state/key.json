{
  "criteria": [
    {
      "id": "C1",
      "weight": 4,
      "description": "the three-second read says the list is empty",
      "path": "thesis.threeSecondRead",
      "match": "containsAny",
      "terms": ["no threads", "empty", "nothing"]
    },
    {
      "id": "C2",
      "weight": 4,
      "description": "names the create or attach action as the first-run path",
      "path": "thesis.firstRunPath",
      "match": "containsAny",
      "terms": ["create", "attach", "new thread"]
    },
    {
      "id": "C3",
      "weight": 2,
      "description": "uses sentence-case, quiet copy",
      "path": "thesis.copyVoice",
      "match": "containsAny",
      "terms": ["sentence", "quiet", "no exclamation"]
    },
    {
      "id": "C4",
      "weight": 2,
      "description": "names the first row appearing without a layout jump",
      "path": "thesis.goodMoment",
      "match": "containsAny",
      "terms": ["first row", "no jump", "appears"]
    },
    {
      "id": "C5",
      "weight": 2,
      "description": "avoids a modal, spinner or tour",
      "path": "thesis.frictionAvoided",
      "match": "containsAny",
      "terms": ["modal", "spinner", "tour"]
    },
    {
      "id": "C6",
      "weight": 2,
      "description": "gives at least two observable evidence points",
