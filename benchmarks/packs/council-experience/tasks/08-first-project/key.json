    { "id": "C2", "weight": 4, "description": "names create or import as the first-run path", "path": "thesis.firstRunPath", "match": "containsAny", "terms": ["create", "import", "new project"] },
    { "id": "C3", "weight": 2, "description": "uses quiet sentence-case copy", "path": "thesis.copyVoice", "match": "containsAny", "terms": ["sentence", "quiet", "no exclamation"] },
    { "id": "C4", "weight": 2, "description": "the first project appears without a layout jump", "path": "thesis.goodMoment", "match": "containsAny", "terms": ["first project", "no jump", "appears"] },
    { "id": "C5", "weight": 2, "description": "avoids a tour, a modal or sample data", "path": "thesis.frictionAvoided", "match": "containsAny", "terms": ["tour", "modal", "sample"] },
    { "id": "C6", "weight": 2, "description": "gives at least two observable evidence points", "path": "evidence", "match": "minItems", "min": 2 },
    { "id": "C7", "weight": 2, "description": "names at least one non-goal", "path": "nonGoals", "match": "minItems", "min": 1 }
  ],
