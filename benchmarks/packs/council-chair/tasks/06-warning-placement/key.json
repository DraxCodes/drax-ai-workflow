    { "id": "C4", "weight": 2, "description": "captures the shape dissent for the topbar", "path": "dissent", "match": "containsObject", "contains": { "seat": "shape", "point": "topbar" } },
    { "id": "C5", "weight": 2, "description": "names C as rejected because a toast is transient", "path": "rejected", "match": "containsObject", "contains": { "option": "C", "why": "transient" } },
    { "id": "C6", "weight": 2, "description": "names the risk position that the state must stay visible", "path": "dissent", "match": "containsObject", "contains": { "seat": "risk", "point": "visible" } }
